
pipeline {
  agent any

  environment {
    // ==================================
    // GitHub 설정
    // ==================================
    GIT_URL                = 'https://github.com/seyeonJeong/myfirst-api-server.git'
    GIT_BRANCH             = 'main'
    GIT_ID                 = 'skala-github-id'

    // ==================================
    // 사용자 설정
    // ==================================
    USER_NAME              = 'sk166'
    SERVICE_NAME           = 'myfirst-api-server'

    // ==================================
    // 컨테이너 이미지 설정
    // ==================================
    IMAGE_NAME             = 'sk166-webserver'
    IMAGE_TAG              = '1.0'

    // ==================================
    // Harbor Registry (판교)
    // ==================================
    IMAGE_REGISTRY_URL     = 'skala-registry.skala-ai.com'
    IMAGE_REGISTRY_PROJECT = 'class-5'
    DOCKER_CREDENTIAL_ID   = 'skala-image-registry-id'

    // ==================================
    // Kubernetes 설정
    // ==================================
    K8S_NAMESPACE          = 'class-5'
    DEPLOYMENT_NAME        = 'sk166-myfirst-api-server'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  stages {

    // ==================================
    // 1. GitHub 소스코드 가져오기
    // ==================================
    stage('Clone Repository') {
      steps {
        echo '=== Clone Repository ==='

        git branch: "${GIT_BRANCH}",
            url: "${GIT_URL}",
            credentialsId: "${GIT_ID}"

        sh 'ls -al'
      }
    }

    // ==================================
    // 2. Maven Build
    // ==================================
    stage('Build with Maven') {
      steps {
        echo '=== Build with Maven ==='

        sh '''
          set -eu

          echo "=== Maven Version ==="
          mvn -version

          echo "=== Maven Package ==="
          mvn clean package -DskipTests

          echo "=== Build Result ==="
          ls -al target/
        '''
      }
    }

    // ==================================
    // 3. Buildah Image Build & Push
    // ==================================
    stage('Image Build & Push (Buildah)') {
      steps {
        echo '=== Image Build & Push (Buildah) ==='

        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {

          sh '''
            set -eu

            REG_HOST="${IMAGE_REGISTRY_URL}"

            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}-${BUILD_NUMBER}"

            echo "=== Harbor Login ==="

            printf '%s' "$REG_PASS" | sudo buildah login \
              -u "$REG_USER" \
              --password-stdin "$REG_HOST"

            echo "=== Buildah Image Build ==="

            sudo buildah bud \
              --storage-driver=vfs \
              --platform "linux/amd64" \
              -t "${IMAGE_REF}" .

            echo "=== Buildah Image Push ==="

            sudo buildah push \
              --storage-driver=vfs \
              "${IMAGE_REF}"

            echo "=== Buildah Cleanup ==="

            sudo buildah rmi -a || true

            echo "=== Image Build & Push Completed ==="
          '''
        }
      }
    }

    // ==================================
    // 4. Kubernetes Manifest 업데이트
    // ==================================
    stage('Update K8s Manifests') {
      steps {
        echo '=== Update Kubernetes Manifests ==='

        sh '''
          set -eu

          echo "=== Check Kustomize Directory ==="
          test -d ./kustomize/overlays/dev

          cd ./kustomize/overlays/dev

          FINAL_IMAGE_TAG="${IMAGE_TAG}-${BUILD_NUMBER}"

          IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

          echo "=== Update Image Tag ==="

          kustomize edit set image \
            "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}"

          echo "=== Updated kustomization.yaml ==="

          cat ./kustomization.yaml
        '''
      }
    }

    // ==================================
    // 5. Kubernetes 배포
    // ==================================
    stage('Deploy to Kubernetes') {
      steps {
        echo '=== Deploy to Kubernetes ==='

        sh '''
          set -eu

          FINAL_IMAGE_TAG="${IMAGE_TAG}-${BUILD_NUMBER}"

          IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

          echo "=== Kubernetes Environment ==="
          echo "Namespace: ${K8S_NAMESPACE}"
          echo "Deployment: ${DEPLOYMENT_NAME}"
          echo "Image: ${IMAGE_BASE}:${FINAL_IMAGE_TAG}"

          echo "=== Check Kubernetes Tools ==="

          kubectl version --client
          kustomize version

          echo "=== Apply Kubernetes Manifests ==="

          kustomize build ./kustomize/overlays/dev |
            kubectl apply -n "${K8S_NAMESPACE}" -f -

          echo "=== Wait for Deployment Rollout ==="

          kubectl rollout status \
            deployment/"${DEPLOYMENT_NAME}" \
            -n "${K8S_NAMESPACE}" \
            --timeout=180s

          echo "=== Check Deployment ==="

          kubectl get deployment \
            "${DEPLOYMENT_NAME}" \
            -n "${K8S_NAMESPACE}"

          echo "=== Check Pods ==="

          kubectl get pods \
            -n "${K8S_NAMESPACE}" \
            -l "app=${DEPLOYMENT_NAME}"

          echo "=== Kubernetes Deployment Completed ==="
        '''
      }
    }
  }

  // ==================================
  // Pipeline 실행 결과 처리
  // ==================================
  post {
    success {
      echo '=== Jenkins CI/CD Pipeline SUCCESS ==='
    }

    failure {
      echo '=== Jenkins CI/CD Pipeline FAILED ==='
    }

    always {
      echo '=== Cleaning Jenkins Workspace ==='
      deleteDir()
    }
  }
}