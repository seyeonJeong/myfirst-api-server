
pipeline {
  agent any

  environment {
    // ===== GitHub =====
    GIT_URL = 'https://github.com/seyeonJeong/myfirst-api-server.git'
    GIT_BRANCH = 'main'
    GIT_ID = 'skala-github-id'

    // ===== 사용자 정보 =====
    USER_NAME = 'sk166'
    SERVICE_NAME = 'myfirst-api-server'

    // ===== 컨테이너 이미지 =====
    IMAGE_NAME = 'sk166-webserver'
    IMAGE_TAG = '1.0'

    // ===== Harbor Registry (판교) =====
    IMAGE_REGISTRY_URL = 'skala-registry.skala-ai.com'
    IMAGE_REGISTRY_PROJECT = 'class-5'
    DOCKER_CREDENTIAL_ID = 'skala-image-registry-id'

    // ===== Kubernetes / GitOps =====
    K8S_NAMESPACE = 'class-5'
    GITOPS_BRANCH = 'gitops'
    GITOPS_MANIFEST_DIR = 'kustomize/overlays/dev'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
    skipDefaultCheckout(true)
  }

  stages {

    // ==================================
    // 1. Clone Repository
    // ==================================
    stage('Clone Repository') {
      steps {
        echo '=== Clone Repository ==='

        git branch: "${GIT_BRANCH}",
            url: "${GIT_URL}",
            credentialsId: "${GIT_ID}"

        sh '''
          set -eu
          git status --short
          git rev-parse --short HEAD
          ls -al
        '''
      }
    }

    // ==================================
    // 2. Maven Build
    // ==================================
    stage('Build with Maven') {
      steps {
        echo '=== Build with Maven ==='

        sh '''
          set -eu

          mvn -version
          mvn clean package -DskipTests

          echo "=== Build Result ==="
          ls -al target/
        '''
      }
    }

    // ==================================
    // 3. Buildah Image Build & Push
    // ==================================
    stage('Image Build & Push (Buildah)') {
      steps {
        script {
          def shortCommit = sh(
            script: 'git rev-parse --short=7 HEAD',
            returnStdout: true
          ).trim()

          env.FINAL_IMAGE_TAG =
            "${env.IMAGE_TAG}-bd${env.BUILD_NUMBER}-${shortCommit}"

          echo "Image Tag: ${env.FINAL_IMAGE_TAG}"
        }

        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
          sh '''
            set -eu

            REG_HOST="${IMAGE_REGISTRY_URL}"
            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${FINAL_IMAGE_TAG}"

            echo "=== Harbor Login ==="

            printf '%s' "$REG_PASS" | sudo buildah login \
              -u "$REG_USER" \
              --password-stdin "$REG_HOST"

            echo "=== Buildah Build ==="

            sudo buildah bud \
              --storage-driver=vfs \
              --platform "linux/amd64" \
              -t "${IMAGE_REF}" .

            echo "=== Buildah Push ==="

            sudo buildah push \
              --storage-driver=vfs \
              "${IMAGE_REF}"

            echo "=== Buildah Cleanup ==="

            sudo buildah rmi -a || true

            echo "=== Image Push Complete ==="
          '''
        }
      }
    }

    // ==================================
    // 4. GitOps Update
    // ==================================
    stage('GitOps Update') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${GIT_ID}",
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_PASS'
        )]) {

          sh '''
            set -eu
            set +x

            git config user.name "skala-gitops"
            git config user.email "skala@skala-ai.com"

            echo "=== Prepare Git Credentials ==="

            AUTH_HEADER=$(printf '%s:%s' "$GIT_USER" "$GIT_PASS" | base64 | tr -d '\\n')
            export GIT_CONFIG_COUNT=1
            export GIT_CONFIG_KEY_0=http.extraheader
            export GIT_CONFIG_VALUE_0="AUTHORIZATION: basic ${AUTH_HEADER}"

            echo "=== Fetch GitOps Branch ==="

            if git fetch origin "refs/heads/${GITOPS_BRANCH}:refs/remotes/origin/${GITOPS_BRANCH}"; then
              git checkout -B "${GITOPS_BRANCH}" "refs/remotes/origin/${GITOPS_BRANCH}"
            else
              echo "GitOps branch not found: creating from main"
              git checkout -B "${GITOPS_BRANCH}"
            fi

            echo "=== Update Kustomize Image ==="

            test -f "${GITOPS_MANIFEST_DIR}/kustomization.yaml"

            IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

            (
              cd "${GITOPS_MANIFEST_DIR}"
              kustomize edit set image \
                "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}"
            )

            echo "=== Updated Manifest ==="
            cat "${GITOPS_MANIFEST_DIR}/kustomization.yaml"

            echo "=== Commit GitOps Change ==="

            git add "${GITOPS_MANIFEST_DIR}/kustomization.yaml"

            if git diff --cached --quiet; then
              echo "No manifest changes"
            else
              git commit -m "[AUTO] image: ${IMAGE_NAME}:${FINAL_IMAGE_TAG}"
            fi

            echo "=== Push GitOps Branch ==="

            git push origin "HEAD:refs/heads/${GITOPS_BRANCH}"

            echo "=== GitOps Update Completed ==="
          '''
        }
      }
    }
  }

  post {
    success {
      echo '=== Jenkins CI Pipeline SUCCESS ==='
    }

    failure {
      echo '=== Jenkins CI Pipeline FAILED ==='
    }

    always {
      echo '=== Cleaning Workspace ==='
      deleteDir()
    }
  }
}
